# Defaults for a browser on this machine. For a physical device use the host LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Nome público e esquema de deep link. A API usa APP_NAME e APP_SCHEME com os mesmos padrões.
EXPO_PUBLIC_APP_NAME=Tio de Pet
EXPO_PUBLIC_APP_SCHEME=tiodepet
